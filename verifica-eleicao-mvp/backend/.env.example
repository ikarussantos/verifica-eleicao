# Nunca publique o arquivo .env no GitHub.
GEMINI_API_KEY=sua_chave_aqui
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-flash-lite-latest,gemini-3.1-flash-lite
FRONTEND_ORIGIN=*
PORT=3000
GEMINI_WEB_SEARCH=false
# Chave do Google Cloud com a Fact Check Tools API ativada (opcional, gratuita)
FACTCHECK_API_KEY=
RATE_LIMIT_PER_HOUR=20
